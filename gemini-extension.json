{
  "name": "entroly",
  "version": "1.0.84",
  "description": "Evidence operations and bounded context selection for Gemini CLI.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "entroly": {
      "command": "entroly",
      "args": [
        "serve"
      ],
      "env": {
        "ENTROLY_NO_DOCKER": "1",
        "ENTROLY_MCP_PASSIVE": "1",
        "ENTROLY_MAX_FILES": "200"
      }
    }
  }
}
