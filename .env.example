# Entroly requires no environment variables or API keys for local installation,
# `entroly verify-claims`, `entroly simulate`, or the normal test suite.
#
# This file documents common opt-in settings for contributors. Entroly does not
# automatically load `.env`; export the values in your shell or use your usual
# environment loader. Copy this file to `.env` only when you need an optional
# integration, and never commit live credentials.

# Local state and workspace overrides
# ENTROLY_DIR=.entroly
# ENTROLY_SOURCE=/absolute/path/to/workspace

# Disable the one-time native-engine package download and stay fully offline.
# ENTROLY_NO_SELF_HEAL=1
# ENTROLY_AIR_GAP=1

# Provider credentials are needed only for provider-bound proxy paths or live
# benchmarks. Leave them unset for local development and offline tests.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional upstream endpoints for compatible provider proxies.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
