{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entroly-community-savings",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://juyterman1000.github.io",
    "RETENTION_DAYS": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entroly-community-savings",
      "database_id": "8dd8d61c-239e-460c-986a-f2ad30ae3f33"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "11002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
