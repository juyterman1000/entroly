# ═══════════════════════════════════════════════════════════════════════════
# Entroly Docker Image — Multi-platform (amd64 + arm64)
#
# Build: docker build -f Dockerfile.entroly -t entroly .
# Default stdio MCP:
#   docker run --rm -i entroly
# Linux loopback proxy:
#   docker run --rm --network=host \
#     -e ENTROLY_PROXY_HOST=127.0.0.1 entroly --proxy
#
# Bridge-network proxy deployment is an advanced remote-bind mode. It must set
# ENTROLY_ALLOW_REMOTE_PROXY=1, ENTROLY_PROXY_ACCESS_TOKEN, and
# ENTROLY_REMOTE_PROXY_TRUSTED_TRANSPORT=1, then publish only to host loopback.
# Normal pip-installed users should run `entroly proxy` or `entroly serve --proxy`.
# ═══════════════════════════════════════════════════════════════════════════

# Stage 1: Build Rust extension
FROM python:3.13 AS builder

WORKDIR /build

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y curl build-essential libssl-dev pkg-config \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir maturin

# entroly-core path-depends on the shared SSOT crate `entroly-qccr` (and future
# entroly-* logic crates), so the build context must include it — a manual
# `maturin build` does not auto-vendor path deps the way an sdist build does.
COPY entroly-qccr/ ./entroly-qccr/
COPY entroly-core/ ./entroly-core/
RUN cd entroly-core && maturin build --release -o /build/wheels/

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.13-slim

LABEL io.modelcontextprotocol.server.name="io.github.juyterman1000/entroly"

WORKDIR /app

# Install the Rust wheel and runtime deps. MCP v2 is a breaking SDK generation;
# keep the production image on the maintained v1 line until Entroly completes a
# separately tested migration.
COPY --from=builder /build/wheels/*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl \
    "mcp>=1.28.1,<2" "httpx>=0.28.1" "starlette>=1.3.1" "uvicorn>=0.51.0" \
    && rm -rf /tmp/wheels

# Copy entroly Python package (all modules — glob avoids missing new files)
COPY entroly/ /app/entroly/

# Copy bench directory (tuning_config.json + benchmark cases for autotune)
COPY bench/ /app/bench/

COPY pyproject.toml /app/
COPY README.md /app/
COPY LICENSE NOTICE /app/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 9377

# Stdio MCP has no HTTP endpoint; proxy mode does. The probe inspects the actual
# PID 1 mode and checks the appropriate contract rather than marking default MCP
# containers unhealthy for not running an unrelated proxy.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD ["python", "-m", "entroly.container_health"]

ENTRYPOINT ["python", "-m", "entroly.container_entry"]
