{
  "mcpServers": {
    "entroly": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/entroly-plugin-launch.mjs"
      ],
      "env": {
        "ENTROLY_NO_DOCKER": "1",
        "ENTROLY_MCP_PASSIVE": "1",
        "ENTROLY_MCP_PROFILE": "public",
        "ENTROLY_MAX_FILES": "200"
      }
    }
  }
}
