{
  "manifest_version": 3,
  "name": "Entroly — Context Compression & Receipts for GitHub",
  "version": "1.0.0",
  "description": "Compress GitHub repositories and source code by 70%+ for Claude, GPT-4, and Cursor with verifiable Merkle receipts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@entroly.ai",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Entroly Context Compressor"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
