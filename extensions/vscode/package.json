{
  "name": "entroly-vscode",
  "displayName": "Entroly \u2014 Context Compression & Receipts",
  "description": "Select and compress repository context for AI tools with auditable receipts.",
  "version": "1.0.88",
  "publisher": "entroly",
  "repository": {
    "type": "git",
    "url": "https://github.com/juyterman1000/entroly.git",
    "directory": "extensions/vscode"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "context compression",
    "token optimizer",
    "merkle receipt",
    "claude",
    "copilot",
    "cursor",
    "llm",
    "entroly"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "entroly.compressSelection",
        "title": "Entroly: Compress Selection",
        "category": "Entroly"
      },
      {
        "command": "entroly.compressFile",
        "title": "Entroly: Compress Current File for Prompt",
        "category": "Entroly"
      },
      {
        "command": "entroly.viewReceipt",
        "title": "Entroly: View Last Compress Receipt",
        "category": "Entroly"
      },
      {
        "command": "entroly.openPlayground",
        "title": "Entroly: Open Interactive Web Playground",
        "category": "Entroly"
      }
    ],
    "keybindings": [
      {
        "command": "entroly.compressSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Entroly Configuration",
      "properties": {
        "entroly.tokenBudget": {
          "type": "number",
          "default": 450,
          "description": "Token budget shown beside the status bar token count"
        },
        "entroly.showStatusBarTokens": {
          "type": "boolean",
          "default": true,
          "description": "Show live token count in the VS Code status bar"
        },
        "entroly.useCliIfAvailable": {
          "type": "boolean",
          "default": true,
          "description": "Run the local 'entroly compress' CLI for the compress commands. They have no other implementation, so when this is off they only say so."
        },
        "entroly.syncUnsavedBuffers": {
          "type": "boolean",
          "default": false,
          "description": "Allow sending unsaved editor buffers to the configured Entroly proxy so context selection can rank what you see, not the version on disk."
        },
        "entroly.proxyUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9377",
          "description": "Base URL of the local Entroly proxy used for unsaved-buffer sync."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.4"
  }
}
